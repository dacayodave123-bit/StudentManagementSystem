package Acitvity;

import java.util.Scanner;
import java.util.ArrayList;
public class studentManagementSystem {
    public static void main (String args []) {
        
     Scanner scan = new Scanner (System.in);
      ArrayList<String> student = new ArrayList<>();
      
      while (true){
          System.out.println("=========================");
          System.out.println("\nSTUDENT MANAGEMENT SYSTEM");
          System.out.println("\n=========================");
          System.out.println("1. Add a Student Name ");
          System.out.println("2. View a Student Name ");
          System.out.println("3. Search a Student Name ");
          System.out.println("4. Remove a Student Name ");
          System.out.println("5. Exit");
          
          System.out.print("Enter a number to Proceed: ");
          
          int decision = scan.nextInt();
          scan.nextLine();
          
          if (decision == 1 ) {
              System.out.print("Enter a name to add to the Student List: ");
              String name = scan.nextLine();
              student.add(name);
              System.out.println("name is added to the Student List Successfully.");
          }
          else if (decision == 2) {
          if (student.isEmpty()) {
              System.out.println("Student List is Empty.");
          }else{
              System.out.println("\nSTUDENT LIST OF NAME:");
              for (int i = 0; i<student.size(); i++) {
                  System.out.println((i + 1) + "." + (student.get(i)));
              }
          }
      }
          else if (decision == 3) {
              System.out.print("Enter a name to search in the Student List: ");
              String search = scan.nextLine();
              if (student.contains(search)) {
                  System.out.println("The name verified, on the Student List ");
              }else{
                  System.out.println("The name is not verified on the Student List");
              }
          }
          else if (decision == 4) {
              System.out.print("Enter a name to be removed from the Student List: ");
              String remove = scan.nextLine();
              if (student.contains(remove)){
                  student.remove(remove);
                  System.out.println("The name is removed from the Student List successfully.");
              }else{
                  System.out.println("The name is not found on the Student List.");
              }
          }
          else if (decision == 5) {
              System.out.println("Exiting the Program......");
              break;
          }else{
              System.out.println("System error, Please try again.");
          }
      }
      }
    }